<Window x:Class="WpfClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RS-232 demo - WPF to Raspberry Pi 4B"
        Height="740" Width="940" MinHeight="620" MinWidth="820"
        Closing="Window_Closing">

    <Window.Resources>
        <Style TargetType="ComboBox"><Setter Property="Margin" Value="0,3"/></Style>
        <Style TargetType="TextBox"><Setter Property="Margin" Value="0,3"/><Setter Property="Padding" Value="3"/></Style>
        <Style TargetType="Button"><Setter Property="Padding" Value="10,4"/><Setter Property="Margin" Value="0,3,6,3"/></Style>
        <Style TargetType="GroupBox"><Setter Property="Margin" Value="0,0,0,10"/><Setter Property="Padding" Value="8"/></Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="12">

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Disconnected"/>
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: settings and commands -->
            <StackPanel Grid.Column="0">

                <GroupBox Header="1. Serial port settings">
                    <StackPanel>
                        <Grid x:Name="SettingsGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="95"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Style="{StaticResource Label}" Text="Port"/>
                            <Grid Grid.Row="0" Grid.Column="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="PortBox"/>
                                <Button Grid.Column="1" Content="Refresh" Margin="6,3,0,3" Click="Refresh_Click"/>
                            </Grid>

                            <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="Baud rate"/>
                            <ComboBox Grid.Row="1" Grid.Column="1" x:Name="BaudBox" IsEditable="True"/>

                            <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="Data bits"/>
                            <ComboBox Grid.Row="2" Grid.Column="1" x:Name="DataBitsBox"/>

                            <TextBlock Grid.Row="3" Style="{StaticResource Label}" Text="Parity"/>
                            <ComboBox Grid.Row="3" Grid.Column="1" x:Name="ParityBox"/>

                            <TextBlock Grid.Row="4" Style="{StaticResource Label}" Text="Stop bits"/>
                            <ComboBox Grid.Row="4" Grid.Column="1" x:Name="StopBitsBox"/>

                            <TextBlock Grid.Row="5" Style="{StaticResource Label}" Text="Flow control"/>
                            <ComboBox Grid.Row="5" Grid.Column="1" x:Name="FlowBox"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="ConnectBtn" Content="Connect" Click="Connect_Click"/>
                            <Button x:Name="DisconnectBtn" Content="Disconnect" IsEnabled="False" Click="Disconnect_Click"/>
                            <Ellipse x:Name="StatusDot" Width="14" Height="14" Fill="Gray" Margin="6,0,0,0"
                                     VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox x:Name="CommandsGroup" Header="2. Send requests to the Pi" IsEnabled="False">
                    <StackPanel>
                        <WrapPanel>
                            <Button Content="Ping" Tag="PING" Click="Quick_Click"/>
                            <Button Content="Temperature" Tag="GET TEMP" Click="Quick_Click"/>
                            <Button Content="Time" Tag="GET TIME" Click="Quick_Click"/>
                            <Button Content="Info" Tag="GET INFO" Click="Quick_Click"/>
                            <Button Content="Memory" Tag="GET MEM" Click="Quick_Click"/>
                        </WrapPanel>

                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Label}" Text="Read timeout (ms)"/>
                            <TextBox Grid.Column="1" x:Name="TimeoutBox" Text="2000"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Label}" Text="Pi reply delay (s)"/>
                            <TextBox Grid.Column="1" x:Name="SlowBox" Text="5"/>
                            <Button Grid.Column="2" Content="Send slow" Margin="8,3,0,3" Click="Slow_Click"/>
                        </Grid>

                        <TextBlock Foreground="Gray" TextWrapping="Wrap" FontSize="11"
                                   Text="Send slow asks the Pi to wait before replying. If the delay is longer than the read timeout, the request times out."/>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="CustomBox" Text="ECHO hello" KeyDown="CustomBox_KeyDown"/>
                            <Button Grid.Column="1" Content="Send" Margin="6,3,0,3" Click="CustomSend_Click"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>

            </StackPanel>

            <!-- RIGHT: data and log -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <GroupBox Grid.Row="0" Header="3. Latest data from the Pi">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Margin="0,2" Text="CPU temperature"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,2" x:Name="TempText" Text="-" FontWeight="SemiBold"/>

                        <TextBlock Grid.Row="1" Margin="0,2" Text="Pi time"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,2" x:Name="TimeText" Text="-" FontWeight="SemiBold"/>

                        <TextBlock Grid.Row="2" Margin="0,2" Text="Pi info"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,2" x:Name="InfoText" Text="-" FontWeight="SemiBold" TextWrapping="Wrap"/>

                        <TextBlock Grid.Row="3" Margin="0,2" Text="Memory"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,2" x:Name="MemText" Text="-" FontWeight="SemiBold"/>

                        <TextBlock Grid.Row="4" Margin="0,2" Text="Last round trip"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,2" x:Name="RttText" Text="-" FontWeight="SemiBold"/>

                        <TextBlock Grid.Row="5" Margin="0,2" Text="Counters"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" Margin="0,2" x:Name="CountText"
                                   Text="sent 0 / replies 0 / timeouts 0" FontWeight="SemiBold"/>
                    </Grid>
                </GroupBox>

                <GroupBox Grid.Row="1" Header="4. Traffic log" Margin="0">
                    <DockPanel>
                        <Button DockPanel.Dock="Bottom" HorizontalAlignment="Left" Content="Clear log" Click="ClearLog_Click"/>
                        <ListBox x:Name="LogList" FontFamily="Consolas"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Text}" Foreground="{Binding Brush}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </GroupBox>
            </Grid>

        </Grid>
    </DockPanel>
</Window>
